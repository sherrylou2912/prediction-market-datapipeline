        "event_id": {
          "type": "str",
          "description": "来源事件标识。"
        },
        "title": {
          "type": "str",
          "description": "事件或市场标题。"
        },
        "observed_at": {
          "type": "utc_datetime",
          "description": "本系统观察到该值的 UTC 时间。"
        },
        "bronze_run_id": {
          "type": "str",
          "description": "对应 Bronze 记录的运行标识。"
        },
        "bronze_record_index": {
          "type": "int",
          "description": "对应 Bronze 记录在运行中的序号。"
        },
        "schema_version": {
          "type": "str",
          "description": "本行使用的数据契约版本。"
        }
      },
      "rules": [
        {
          "type": "version",
          "field": "schema_version"
        },
        {
          "type": "range",
          "field": "bronze_record_index",
          "min": "0"
        }
      ]
    },
    "silver.markets": {
      "primary_key": [
        "venue",
        "market_id",
        "observed_at"
      ],
      "fields": {
        "venue": {
          "type": "str",
          "description": "来源交易场所标识。"
        },
        "market_id": {
          "type": "str",
          "description": "来源市场标识。"
        },
        "event_id": {
          "type": "str?",
          "description": "来源事件标识。"
        },
        "title": {
          "type": "str",
          "description": "事件或市场标题。"
        },
        "description": {
          "type": "str?",
          "description": "来源提供的市场描述原文；来源未提供时为空。"
        },
        "settlement_rules": {
          "type": "str?",
          "description": "来源提供的结算条件原文；来源未提供时为空。"
        },
        "status": {
          "type": "str",
          "description": "市场状态：pending、open、closed、settled、cancelled 或 unknown。"
        },
        "scheduled_open_at": {
          "type": "utc_datetime?",
          "description": "来源公布的计划开放 UTC 时间；未提供或来源未区分计划与实际时为空，原文见 source_open_time_text / source_close_time_text。"
        },
        "scheduled_close_at": {
          "type": "utc_datetime?",
          "description": "来源公布的计划关闭 UTC 时间；未提供或来源未区分计划与实际时为空，原文见 source_open_time_text / source_close_time_text。"
        },
        "actual_open_at": {
          "type": "utc_datetime?",
          "description": "有可靠证据的实际开放 UTC 时间；无证据或来源未区分计划与实际时为空，原文见 source_open_time_text / source_close_time_text。"
        },
        "actual_close_at": {
          "type": "utc_datetime?",
          "description": "有可靠证据的实际关闭 UTC 时间；无证据或来源未区分计划与实际时为空，原文见 source_open_time_text / source_close_time_text。"
        },
        "source_open_time_text": {
          "type": "str?",
          "description": "来源提供但未说明属于计划还是实际的开放时间原文，按原样保存、不解析；来源已明确区分或未提供时为空。"
        },
        "source_close_time_text": {
          "type": "str?",
          "description": "来源提供但未说明属于计划还是实际的关闭时间原文，按原样保存、不解析；来源已明确区分或未提供时为空。"
        },
        "observed_at": {
          "type": "utc_datetime",
          "description": "本系统观察到该值的 UTC 时间。"
        },
        "bronze_run_id": {
          "type": "str",
          "description": "对应 Bronze 记录的运行标识。"
        },
        "bronze_record_index": {
          "type": "int",
          "description": "对应 Bronze 记录在运行中的序号。"
        },
        "schema_version": {
          "type": "str",
          "description": "本行使用的数据契约版本。"
        }
      },
      "rules": [
        {
          "type": "version",
          "field": "schema_version"
        },
        {
          "type": "range",
          "field": "bronze_record_index",
          "min": "0"
        },
        {
          "type": "enum",
          "field": "status",
          "values": [
            "pending",
            "open",
            "closed",
            "settled",
            "cancelled",
            "unknown"
          ]
        },
        {
          "type": "compare",
          "left": "scheduled_open_at",
          "op": "<=",
          "right": "scheduled_close_at"
        },
        {
          "type": "compare",
          "left": "actual_open_at",
          "op": "<=",
          "right": "actual_close_at"
        }
      ]
    },
