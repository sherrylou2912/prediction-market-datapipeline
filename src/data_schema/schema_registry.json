{
  "version": "7.0.0",
  "version_field": "schema_version",
  "datasets": {
    "bronze.raw": {
      "primary_key": [
        "run_id",
        "record_index"
      ],
      "fields": {
        "run_id": {
          "type": "str",
          "description": "接收运行的唯一标识。"
        },
        "record_index": {
          "type": "int",
          "description": "运行内接收记录序号，从 0 开始。"
        },
        "venue": {
          "type": "str?",
          "description": "来源交易场所标识；不适用或未知时为空。"
        },
        "source": {
          "type": "str",
          "description": "原始数据来源标识。"
        },
        "message_type": {
          "type": "str",
          "description": "来源消息类型。"
        },
        "source_event_id": {
          "type": "str?",
          "description": "来源提供的事件标识；未知时为空。"
        },
        "event_time": {
          "type": "utc_datetime?",
          "description": "来源事件发生的 UTC 时间；未知时为空。"
        },
        "received_at": {
          "type": "utc_datetime?",
          "description": "本系统接收来源记录的 UTC 时间；未知时为空。"
        },
        "ingested_at": {
          "type": "utc_datetime?",
          "description": "原始记录写入的 UTC 时间；未知时为空。"
        },
        "sequence": {
          "type": "int?",
          "description": "来源序列号；未提供时为空。"
        },
        "api_version": {
          "type": "str?",
          "description": "来源 API 版本；不适用或未知时为空。"
        },
        "protocol_version": {
          "type": "str?",
          "description": "来源协议版本；不适用时为空。"
        },
        "schema_version": {
          "type": "str",
          "description": "本行使用的数据契约版本。"
        },
        "raw_payload": {
          "type": "json?",
          "description": "来源消息的 JSON 原文；与 raw_bytes 恰好填写一个。"
        },
        "raw_bytes": {
          "type": "binary?",
          "description": "来源原始字节，可含非 JSON、无效编码或空内容；与 raw_payload 恰好填写一个。"
        }
      },
      "rules": [
        {
          "type": "version",
          "field": "schema_version"
        },
        {
          "type": "range",
          "field": "record_index",
          "min": "0"
        },
        {
          "type": "range",
          "field": "sequence",
          "min": "0"
        },
        {
          "type": "exactly_one_present",
          "left": "raw_payload",
          "right": "raw_bytes"
        }
      ]
    },
