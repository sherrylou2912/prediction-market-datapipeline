        {
          "type": "range",
          "field": "best_ask",
          "min": "0",
          "max": "1"
        },
        {
          "type": "range",
          "field": "mid",
          "min": "0",
          "max": "1"
        },
        {
          "type": "range",
          "field": "microprice",
          "min": "0",
          "max": "1"
        },
        {
          "type": "range",
          "field": "last_trade_price",
          "min": "0",
          "max": "1"
        },
        {
          "type": "range",
          "field": "spread",
          "min": "0"
        },
        {
          "type": "range",
          "field": "bid_depth_top_n",
          "min": "0"
        },
        {
          "type": "range",
          "field": "ask_depth_top_n",
          "min": "0"
        },
        {
          "type": "range",
          "field": "rolling_volume",
          "min": "0"
        },
        {
          "type": "range",
          "field": "update_count",
          "min": "0"
        },
        {
          "type": "range",
          "field": "book_age_ms",
          "min": "0"
        },
        {
          "type": "range",
          "field": "receive_latency_ms",
          "min": "0"
        },
        {
          "type": "range",
          "field": "imbalance",
          "min": "-1",
          "max": "1"
        },
        {
          "type": "compare",
          "left": "best_bid",
          "op": "<=",
          "right": "best_ask"
        },
        {
          "type": "difference",
          "result": "spread",
          "left": "best_ask",
          "right": "best_bid"
        },
        {
          "type": "alignment",
          "field": "second",
          "unit": "second"
        },
        {
          "type": "string_array",
          "field": "source_manifest_ids",
          "nonempty": true
        },
        {
          "type": "window_end",
          "field": "as_of",
          "start": "second",
          "unit": "second"
        },
        {
          "type": "requires_present",
          "field": "spread",
          "required": "best_bid"
        },
        {
          "type": "requires_present",
          "field": "spread",
          "required": "best_ask"
        },
        {
          "type": "unique_json_keys",
          "field": "source_manifest_ids"
        },
        {
          "type": "requires_present",
          "field": "mid",
          "required": "best_bid"
        },
        {
          "type": "requires_present",
          "field": "mid",
          "required": "best_ask"
        },
        {
          "type": "rounded_mean",
          "result": "mid",
          "left": "best_bid",
          "right": "best_ask",
          "scale": 10
        },
        {
          "type": "requires_present",
          "field": "microprice",
          "required": "best_bid"
        },
        {
          "type": "requires_present",
          "field": "microprice",
          "required": "best_ask"
        },
        {
          "type": "requires_present",
          "field": "imbalance",
          "required": "bid_depth_top_n"
        },
        {
          "type": "requires_present",
          "field": "imbalance",
          "required": "ask_depth_top_n"
        },
        {
          "type": "zero_pair_null",
          "left": "bid_depth_top_n",
          "right": "ask_depth_top_n",
          "field": "imbalance"
        }
      ]
    },
